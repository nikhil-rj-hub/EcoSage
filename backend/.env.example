# LLM API key for the Botanical AI Assistant (Anthropic).
# If unset, the backend falls back to a deterministic context-based answer
# instead of calling the LLM (see services/botanical_ai.py).
LLM_API_KEY=

# Optional: override the LLM model used for chat (default: claude-haiku-4-5-20251001)
LLM_MODEL=claude-haiku-4-5-20251001

# Optional: LLM request timeout in seconds (default: 15)
LLM_TIMEOUT_SECONDS=15

# Comma-separated list of origins allowed to call this API (CORS).
# Should include the frontend dev server / deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:5173
